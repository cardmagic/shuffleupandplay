{
  "name": "shuffleupandplay",
  "version": "0.1.0",
  "private": true,
  "description": "Two-player Magic: The Gathering game built on Solid Objects for Node.js",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "doctor": "node src/doctor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "signal-polyfill": "^0.2.2",
    "solid-objects": "^0.14.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
