# Secrets referenced from config/deploy.yml under registry/password, env/secret,
# proxy/ssl and builder/secrets. This file holds no raw credentials, so it is
# safe for git. Every value comes from 1Password.

KAMAL_REGISTRY_PASSWORD=$(op read 'op://Private/docker.io/password')

CLOUDFLARE_ORIGIN_CERT=$(op read 'op://Private/shuffleupandplay-prod/CLOUDFLARE_ORIGIN_CERT')
CLOUDFLARE_ORIGIN_KEY=$(op read 'op://Private/shuffleupandplay-prod/CLOUDFLARE_ORIGIN_KEY')

SHUFFLE_SECRET=$(op read 'op://Private/shuffleupandplay-prod/SHUFFLE_SECRET')
